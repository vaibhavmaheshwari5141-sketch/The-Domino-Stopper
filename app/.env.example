# Copy to .env and fill in. .env is git-ignored: never commit it.
# Only VITE_* variables reach the browser; everything else is read by the API (server/) only.
# In production set the same server variables in the host's environment settings (Netlify: Site configuration ->
# Environment variables), not in a file.

# ---- Data source -----------------------------------------------------------------------------------------------
# "databricks" (default, and always used by the deployed site) or "local" (parquet files, laptop only)
DATA_MODE=databricks

# ---- Databricks ------------------------------------------------------------------------------------------------
# SQL Warehouses -> <your warehouse> -> Connection details: "Server hostname" and "HTTP path"
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
# Settings -> Developer -> Access tokens. Keep it secret.
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=bufferengine
# Give up on a query after this many seconds (a stopped warehouse can take a while to start)
DATABRICKS_TIMEOUT_SECONDS=45

# ---- Local mode ------------------------------------------------------------------------------------------------
# Folder with one <table>.parquet per gold table (notebook 08's consumption_tables/parquet), relative to this folder
LOCAL_DATA_DIR=consumption_tables/parquet
# Folder with the input samples from databricks/03_input_tables_sample.py (<name>_sample.csv or .parquet), shown on
# the Input Data page as sample_<name>. Databricks mode finds the sample_* tables in the schema instead.
LOCAL_INPUT_DIR=../../exports/samples

# ---- API -------------------------------------------------------------------------------------------------------
# Browser origins allowed to call the API from another origin (comma-separated). Same-origin calls need nothing.
CORS_ORIGINS=http://localhost:5173
# How long read endpoints are cached (in the API and on the CDN), in seconds
CACHE_TTL_SECONDS=600

# ---- Browser ---------------------------------------------------------------------------------------------------
# Leave empty: the app calls /api on its own origin. Set only if the API is hosted elsewhere. Public, no secrets.
VITE_API_BASE_URL=
